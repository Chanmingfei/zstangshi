<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件「今日课程」。
  RemoteViews 只认一小撮视图（LinearLayout / FrameLayout / TextView / ImageView …），
  自定义 View 和 <View> 都会在 inflate 时抛 Class not allowed to be inflated，
  所以左侧那根色条用 TextView 的底色来做（setBackgroundColor 是 @RemotableViewMethod，可以远程调用）。

  行数是写死的 4 行（w_row1..w_row4），靠 setViewVisibility 控制显示几行：
  RemoteViews.addView 把子布局塞进 LinearLayout 这条路在不同厂商 ROM 上不稳，
  固定 4 行是唯一「一定画得出来」的写法。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- 标题行：今日课程 ····· 第 11 周 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 日期 · 周几 · 共几门 -->
    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/w_sub"
        android:textSize="11sp" />

    <!--
      行块吃掉「标题与底部一行之间」的全部剩余高度，并让 4 行在里面垂直居中。
      不这么做的话，用户在桌面上把小组件拉高之后，下面会空出一大片 —— 看起来像没画完。
    -->
    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- ── 第 1 行 ── -->
        <LinearLayout
            android:id="@+id/w_row1"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_bar1"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:background="@color/course_required" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/w_sub"
                android:textSize="11sp"
                android:id="@+id/w_time1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/w_meta1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 第 2 行 ── -->
        <LinearLayout
            android:id="@+id/w_row2"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_bar2"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:background="@color/course_required" />

            <TextView
                android:id="@+id/w_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/w_sub"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/w_meta2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 第 3 行 ── -->
        <LinearLayout
            android:id="@+id/w_row3"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_bar3"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:background="@color/course_required" />

            <TextView
                android:id="@+id/w_time3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/w_sub"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/w_meta3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 第 4 行 ── -->
        <LinearLayout
            android:id="@+id/w_row4"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_bar4"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:background="@color/course_required" />

            <TextView
                android:id="@+id/w_time4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/w_sub"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/w_meta4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 还没同步过课表时的提示（与 w_rows 二选一） -->
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:text="@string/widget_empty"
        android:textColor="@color/w_sub"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/w_sub"
        android:textSize="11sp" />
</LinearLayout>
