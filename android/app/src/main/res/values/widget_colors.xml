<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件专用颜色（亮色）。

  与 web/styles/tokens.css 严格同值，改这里必须同步 tokens.css，反之亦然：
    w_bg   = bg-surface       w_ink = text-primary
    w_sub  = text-tertiary    w_line = border-subtle
    course 四色 = course-required / elective / public / practice
  深色版本在 values-night/widget_colors.xml（值取自 tokens.css 的深色主题块）。
  注意：XML 注释里不能出现连续两个减号，所以这里不直接抄 CSS 变量名。
-->
<resources>
    <color name="w_bg">#FFFFFF</color>
    <color name="w_ink">#1C1C1E</color>
    <color name="w_sub">#737379</color>
    <color name="w_line">#D1D1D6</color>
    <!-- 「正在上」那一行的时间与副标题用这个强调色。
         不能用 app 的 brand_primary（#1B3A6B，那是图标与状态栏的深蓝）：
         深色模式下它在深底上几乎不可见，实测就是这样糊成一片的。 -->
    <color name="w_accent">#0062CC</color>

    <color name="course_required">#0062CC</color>
    <color name="course_elective">#2F6FB5</color>
    <color name="course_public">#21803A</color>
    <color name="course_practice">#C8A24A</color>
</resources>
