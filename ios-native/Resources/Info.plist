<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>掌上唐师</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- 实时公交「附近站点」需要定位；仅在使用期间获取，不后台定位。 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于查找你附近的公交站点并展示实时到站信息</string>

    <!-- 乘车码真跳转：调用 canOpenURL / openURL 前必须先把 URL scheme 列进白名单，
         否则 iOS 会直接返回 false。这里是「实际跳转 scheme」+「兼容 / 对齐 Android」的并集，
         白名单多列几个无副作用（上限 50）。 -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <!-- 代码里真正 open 的两个 scheme（对齐 Android TransitCode.kt / iOS BusComponents.swift）：
             支付宝 alipays://platformapi/... / 云闪付 upwallet://rn/...
             这两个是功能必需项，缺了 canOpenURL 会返回 false、乘车码点不动。 -->
        <string>alipays</string>
        <string>upwallet</string>
        <!-- 对齐 Android <queries> 声明 / 兼容旧客户端与部分 ROM 的备用 scheme -->
        <string>alipay</string>
        <string>alipayqr</string>
        <string>uppaywallet</string>
        <string>unionpay</string>
    </array>

    <!-- 未使用非豁免加密，上架时跳过出口合规问卷。 -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- 教务是 http 明文（校外移动数据下 443 不可达），与 Android 侧 usesCleartextTraffic 对齐。
         上架时需在审核备注里说明「校内教务系统仍为 http」。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <key>NSFaceIDUsageDescription</key>
    <string>用面容 ID 解锁已保存的教务密码</string>

    <!-- 冷启动不用 storyboard：品牌深蓝铺满，避免白屏闪一下 -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>

    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
</dict>
</plist>
