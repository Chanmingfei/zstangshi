<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group：主 App 与小组件共享「今日课程」JSON。
         未签名包重签时如果 App Group 能力不可用，代码会自动退回 standard defaults，
         App 自身仍可用，只是小组件读不到数据。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.tstc.zstangshi</string>
    </array>
</dict>
</plist>