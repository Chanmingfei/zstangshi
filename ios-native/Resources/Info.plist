<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hans</string>
    <key>CFBundleDisplayName</key>
    <string>掌上唐师</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- 实时公交「附近站点」需要定位；仅在使用期间获取，不后台定位。 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于查找你附近的公交站点并展示实时到站信息</string>

    <!-- 乘车码真跳转：调用 canOpenURL / openURL 前必须先把 URL scheme 列进白名单，
         否则 iOS 一律返回 false。scheme 以 Android bus/TransitCode.kt 为准。 -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>alipays</string>
        <string>upwallet</string>
        <string>alipay</string>
        <string>unionpay</string>
    </array>

    <!-- 未使用非豁免加密，上架时跳过出口合规问卷。 -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- 教务是 http 明文（校外移动数据下 443 不可达），与 Android usesCleartextTraffic 对齐。
         同时给出精确子域例外，避免一刀切全放开（审核更容易过，行为也更可预期）。
         上架时需在审核备注里说明「校内教务系统仍为 http」。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>tstc.edu.cn</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSExceptionRequiresForwardSecrecy</key>
                <false/>
                <key>NSExceptionMinimumTLSVersion</key>
                <string>TLSv1.0</string>
            </dict>
        </dict>
    </dict>

    <!-- 冷启动不用 storyboard：品牌色铺满，避免白屏闪一下 -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>